# ==========================================================
# Django Blog - environment variables
# ==========================================================
# Copy this file to .env and edit the values:
#     cp .env.example .env
# The .env file is ignored by Git. Never commit real secrets.
#
# Local development works without any of these values
# (SQLite database, emails printed to the terminal).
# ==========================================================

# --- Core ---------------------------------------------------
# Generate a key with:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Set DEBUG=False for Docker and production.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_ID=2
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=UTC
MAINTENANCE_MODE=False

# --- Settings module ----------------------------------------
# Docker Compose already sets this for the web service.
# DJANGO_SETTINGS_MODULE=CoreFolder.settings.production

# --- PostgreSQL (production settings only) -------------------
# With Docker Compose the host is the "db" service, and PGDB_NAME
# must match POSTGRES_DB in docker-compose.yml.
PGDB_NAME=postgres
PGDB_USER=postgres
PGDB_PASS=change-me
PGDB_HOST=db
PGDB_PORT=5432

# --- Email --------------------------------------------------
# Development uses the console backend by default.
# For production SMTP (example values):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# For the smtp4dev container (docker compose --profile dev):
# EMAIL_HOST=mailserver
# EMAIL_PORT=25
# EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Notification addresses ---------------------------------
CONTACT_FROM_EMAIL=noreply@example.com
CONTACT_RECIPIENTS=admin@example.com
BLOG_FROM_EMAIL=noreply@example.com
BLOG_RECIPIENTS=admin@example.com
SIGNUP_FROM_EMAIL=noreply@example.com

# --- HTTPS (production settings only) -----------------------
# Enable only behind an HTTPS proxy.
USE_SSL_CONFIG=False
